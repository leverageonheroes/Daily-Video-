{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "tools/railway/Dockerfile",
    "watchPatterns": ["tools/railway/**", "requirements.txt"]
  },
  "deploy": {
    "cronSchedule": "17 5 * * *",
    "restartPolicyType": "NEVER"
  }
}
