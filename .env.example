# Copy to .env (never commit .env)
FAL_KEY=
# Lightricks LTX API key (cheapest video route). Without it the pipeline uses fal.ai for video too.
LTX_API_KEY=
# ltx (default) or fal
VIDEO_PROVIDER=ltx
# ltx-2-3-fast ($0.03/s at 720p) or ltx-2-3-pro ($0.04/s at 720p, sharper)
LTX_MODEL=ltx-2-3-fast
LTX_RESOLUTION=720x1280
# Upload private, auto-publish after N hours (0 = keep private until you publish by hand)
REVIEW_HOURS=10
# Stop if one run would cost more than this (USD)
DAILY_BUDGET_USD=15
# Set to 1 to test everything for free with placeholder images/clips
MOCK=0
# Set to 0 to render without uploading
YT_UPLOAD=1
