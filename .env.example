# Copy to .env (never commit .env)
FAL_KEY=
# Lightricks LTX API key (cheapest video route). Without it the pipeline uses fal.ai for video too.
LTX_API_KEY=
# ltx (default) or fal
VIDEO_PROVIDER=ltx
# ltx-2-3-fast ($0.03/s at 720p) or ltx-2-3-pro ($0.04/s at 720p, sharper)
LTX_MODEL=ltx-2-3-fast
LTX_RESOLUTION=720x1280
# fal.ai models (defaults are the cheapest tested ones; only set these to override)
# IMAGE_EDIT=fal-ai/flux-2/flash/edit           # keyframes, ~$0.015 each
# VIDEO_I2V=fal-ai/ltx-2-19b/distilled/image-to-video   # fal video fallback, ~$0.02/s
# Upload private, auto-publish after N hours (0 = keep private until you publish by hand)
REVIEW_HOURS=10
# Stop if one run would cost more than this (USD)
DAILY_BUDGET_USD=15
# Set to 1 to test everything for free with placeholder images/clips
MOCK=0
# Set to 0 to render without uploading
YT_UPLOAD=1
# Meta (Facebook + Instagram Stories). System User token with pages_manage_posts, pages_read_engagement,
# pages_show_list, instagram_basic, instagram_content_publish. Leave blank to skip stories.
META_TOKEN=
FLAT_4B_FB_ID=
FLAT_4B_IG_ID=
FRIDGE_HEARTS_FB_ID=
FRIDGE_HEARTS_IG_ID=
DRIZZLE_AND_PUDGE_FB_ID=
DRIZZLE_AND_PUDGE_IG_ID=
# 1 = YouTube uploads go public immediately (ignores REVIEW_HOURS)
YT_PUBLISH_NOW=0
